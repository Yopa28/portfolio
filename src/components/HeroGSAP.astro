---
import { HERO } from "../config/site";

const { subtitle, title, description, cta } = HERO;
---

<section class="hero-gsap">
    <div class="container">
        <div class="hero-content">
            <div class="hero-label">
                <span class="label-text">
                    {
                        subtitle
                            .split(" ")
                            .map((word) => (
                                <span class="label-word">{word}</span>
                            ))
                    }
                </span>
            </div>

            <h1 class="hero-title">
                {
                    Array.isArray(title) ? (
                        title.map((line) => (
                            <span class="title-line">
                                {line.split(" ").map((word) => (
                                    <span class="word">{word}</span>
                                ))}
                            </span>
                        ))
                    ) : (
                        <span class="title-line">
                            {String(title).split(" ").map((word) => (
                                <span class="word">{word}</span>
                            ))}
                        </span>
                    )
                }
            </h1>

            <p class="hero-description">{description}</p>

            <div class="hero-cta">
                <button
                    onclick={`scrollToSection('${cta.primary.targetId}')`}
                    class="btn btn-primary magnetic"
                >
                    <span class="btn-text">{cta.primary.text}</span>
                    <span class="btn-arrow">→</span>
                </button>
                <button
                    onclick={`scrollToSection('${cta.secondary.targetId}')`}
                    class="btn btn-magnetic-underline magnetic magnetic-special"
                >
                    <span class="btn-text">{cta.secondary.text}</span>
                    <span class="magnetic-underline"></span>
                </button>
            </div>
        </div>
    </div>

    <!-- Minimal decorations -->
    <div class="hero-line line-left"></div>
    <div class="hero-line line-right"></div>
</section>

<style>
    .hero-gsap {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        background: var(--bg-primary);
        overflow: hidden;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
        width: 100%;
        position: relative;
        z-index: 1;
    }

    .hero-content {
        max-width: 900px;
        padding-top: 80px;
    }

    .hero-label {
        margin-bottom: 2rem;
        overflow: hidden;
    }

    .label-text {
        display: inline-flex;
        gap: 0.5rem;
        color: #38bdf8;
        font-size: 0.875rem;
        font-weight: 500;
        letter-spacing: 0.2em;
        text-transform: uppercase;
    }

    .label-word {
        display: inline-block;
        transform-origin: center;
    }

    .hero-title {
        font-size: clamp(2.5rem, 5.5vw, 5rem);
        font-weight: 300;
        line-height: 1.2;
        margin-bottom: 2.5rem;
        letter-spacing: -0.02em;
    }

    .title-line {
        display: block; /* Memaksa 'AI Engineer' berada di baris baru */
        overflow: hidden;
        padding: 0.2rem 0;
    }

    .word {
        display: inline-block;
        margin-right: 0.25em; /* Memberi spasi antar kata */
        will-change: transform;
        color: #ffffff;
    }

    .hero-description {
        font-size: clamp(1rem, 2vw, 1.25rem);
        color: #a1a1aa;
        line-height: 1.8;
        margin-bottom: 3rem;
        max-width: 600px;
        font-weight: 300;
    }

    .hero-cta {
        display: flex;
        gap: 3rem;
        flex-wrap: wrap;
        margin-bottom: 4rem;
        align-items: center;
    }

    .btn {
        position: relative;
        padding: 1rem 2rem;
        font-weight: 500;
        font-size: 0.95rem;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        cursor: pointer;
        will-change: transform;
        letter-spacing: 0.02em;
        border-radius: 50px;
    }

    .btn-primary {
        background: linear-gradient(135deg, #2563eb, #06b6d4);
        color: #ffffff;
        border: none;
        box-shadow: 0 4px 20px rgba(37, 99, 235, 0.3);
    }

    .btn-primary:hover {
        transform: translateX(4px);
        box-shadow: 0 6px 25px rgba(6, 182, 212, 0.4);
    }

    .btn-magnetic-underline {
        position: relative;
        padding: 0.75rem 1rem !important;
        font-weight: 400;
        font-size: 1rem;
        color: #ffffff;
        text-decoration: none;
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        will-change: transform;
        letter-spacing: 0.02em;
        transition:
            background 0.4s cubic-bezier(0.4, 0, 0.2, 1),
            color 0.4s cubic-bezier(0.4, 0, 0.2, 1),
            border-radius 0.4s cubic-bezier(0.4, 0, 0.2, 1),
            padding 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 0;
        background: transparent;
        border: 1px solid transparent;
        transform: translate(0, 0);
    }

    .magnetic-underline {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: #06b6d4;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .btn-magnetic-underline.is-near {
        padding: 1rem 2rem !important;
        border-radius: 50px;
        background: #06b6d4;
        color: #0a0a0f;
        border-color: #06b6d4;
    }

    .btn-magnetic-underline.is-near .magnetic-underline {
        opacity: 0;
    }

    .btn-text {
        position: relative;
        z-index: 1;
        display: inline-block;
    }

    .btn-arrow {
        transition: transform 0.3s ease;
    }

    .btn-primary:hover .btn-arrow {
        transform: translateX(4px);
    }

    .hero-line {
        position: absolute;
        width: 1px;
        height: 100vh;
        background: linear-gradient(
            to bottom,
            transparent,
            rgba(59, 130, 246, 0.15),
            transparent
        );
        top: 0;
    }

    .line-left { left: 10%; }
    .line-right { right: 10%; }

    @media (max-width: 768px) {
        .hero-title {
            font-size: 2.2rem;
        }

        .hero-description {
            font-size: 1.125rem;
        }

        .hero-cta {
            flex-direction: column;
            align-items: stretch;
        }

        .btn {
            justify-content: center;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const tl = gsap.timeline({ defaults: { ease: "power4.out" } });

    gsap.set(".hero-cta .btn", { opacity: 0, y: 20 });

    const labelWords = gsap.utils.toArray(".label-word") as HTMLElement[];
    if (labelWords.length > 0) {
        gsap.set(labelWords[0] as HTMLElement, { opacity: 0, scale: 0, rotation: 180 });
    }
    if (labelWords.length > 1) {
        gsap.set(labelWords[1] as HTMLElement, { opacity: 0, y: -50, rotationX: 90 });
    }

    if (labelWords.length > 0) {
        tl.to(labelWords[0] as HTMLElement, {
            opacity: 1,
            scale: 1,
            rotation: 0,
            duration: 1,
            ease: "elastic.out(1.2, 0.5)",
            delay: 0.2,
        });
    }

    if (labelWords.length > 1) {
        tl.to(
            labelWords[1] as HTMLElement,
            {
                opacity: 1,
                y: 0,
                rotationX: 0,
                duration: 0.8,
                ease: "back.out(2)",
            },
            "-=0.5",
        );
    }

    tl.from(
        ".title-line .word",
        {
            y: 60,
            opacity: 0,
            stagger: 0.15,
            duration: 1,
            ease: "power3.out",
        },
        "-=0.5",
    )
        .from(
            ".hero-description",
            {
                y: 30,
                opacity: 0,
                scale: 0.95,
                duration: 1,
                ease: "power2.out",
            },
            "-=0.8",
        )
        .to(
            ".hero-cta .btn",
            {
                y: 0,
                opacity: 1,
                scale: 1,
                stagger: 0.15,
                duration: 0.8,
                ease: "back.out(1.5)",
            },
            "-=0.5",
        );

    if (labelWords.length > 0) {
        gsap.to(labelWords[0] as HTMLElement, {
            y: -8,
            rotation: 5,
            duration: 1.5,
            ease: "sine.inOut",
            repeat: -1,
            yoyo: true,
            delay: 2,
        });
    }

    if (labelWords.length > 1) {
        gsap.to(labelWords[1] as HTMLElement, {
            y: -5,
            scale: 1.05,
            duration: 2,
            ease: "sine.inOut",
            repeat: -1,
            yoyo: true,
            delay: 2.3,
        });
    }

    gsap.from(".hero-line", {
        scaleY: 0,
        opacity: 0,
        duration: 1.5,
        ease: "power2.out",
        delay: 0.5,
    });

    const buttons = document.querySelectorAll(".magnetic");
    const magneticRadius = 100;

    document.addEventListener("mousemove", (e) => {
        const mouseEvent = e as MouseEvent;

        buttons.forEach((button) => {
            const rect = button.getBoundingClientRect();
            const buttonCenterX = rect.left + rect.width / 2;
            const buttonCenterY = rect.top + rect.height / 2;

            const deltaX = mouseEvent.clientX - buttonCenterX;
            const deltaY = mouseEvent.clientY - buttonCenterY;
            const distance = Math.sqrt(deltaX * deltaX + deltaY * deltaY);

            if (distance < magneticRadius) {
                const strength = 1 - distance / magneticRadius;
                const pullX = deltaX * strength * 0.4;
                const pullY = deltaY * strength * 0.4;

                gsap.to(button, {
                    x: pullX,
                    y: pullY,
                    duration: 0.3,
                    ease: "power2.out",
                });

                if (button.classList.contains("magnetic-special")) {
                    if (distance < 80) {
                        button.classList.add("is-near");
                    } else {
                        button.classList.remove("is-near");
                    }
                }
            } else {
                gsap.to(button, {
                    x: 0,
                    y: 0,
                    duration: 0.5,
                    ease: "power2.out",
                });

                if (button.classList.contains("magnetic-special")) {
                    button.classList.remove("is-near");
                }
            }
        });
    });
</script>