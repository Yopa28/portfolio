    .footer-copyright {
        color: var(--color-text-tertiary);
        font-size: 0.875rem;
    }

    .footer-link {
        color: var(--color-text-secondary);
        text-decoration: none;
        transition: color var(--transition-base);
    }

    .footer-link:hover {
        color: #38bdf8;
    }

    .footer-social {
        display: flex;
