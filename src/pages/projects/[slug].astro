---
import Layout from "../../layouts/Layout.astro";
import { PROJECTS } from "../../config/site";

export function getStaticPaths() {
  return PROJECTS.items.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} - Sandy Yopa Boangmanalu`} description={project.description}>
  <main class="project-detail">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="container">
        <a href="/#projects" class="back-link">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Back to Projects
        </a>
        
        <div class="hero-content">
          <div class="hero-header">
            <span class="project-category">{project.category}</span>
            <h1 class="project-title">{project.title}</h1>
            <p class="project-tagline">{project.tagline}</p>
          </div>

          <div class="project-meta">
            <div class="tech-stack">
              {project.tags.map((tag) => (
                <span class="tech-badge">{tag}</span>
              ))}
            </div>
            <div class="project-links">
              {project.link && (
                <a href={project.link} target="_blank" rel="noopener noreferrer" class="primary-btn">
                  Live Demo
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                </a>
              )}
              {project.github && (
                <a href={project.github} target="_blank" rel="noopener noreferrer" class="secondary-btn">
                  GitHub Repo
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                  </svg>
                </a>
              )}
            </div>
          </div>
        </div>

        {project.gallery && project.gallery.length > 0 && (
          <div class={`gallery-showcase ${project.slug === 'cashwave-mobile' ? 'is-mobile' : ''}`} data-gallery-images={JSON.stringify(project.gallery)}>
            <div class="gallery-device-shell">
              <button type="button" class="gallery-nav gallery-prev" aria-label="Previous preview">‹</button>
              <div class="gallery-feature">
                <button
                  type="button"
                  class="gallery-feature-button"
                  data-open-gallery="0"
                  aria-label={`Open ${project.title} preview 1`}
                >
                  <img src={project.gallery[0]} alt={`${project.title} preview 1`} />
                </button>
              </div>
              <button type="button" class="gallery-nav gallery-next" aria-label="Next preview">›</button>
            </div>

            <div class="gallery-thumbs" role="tablist" aria-label={`${project.title} gallery`}>
              {project.gallery.map((image, index) => (
                <button
                  type="button"
                  class={`gallery-thumb ${index === 0 ? 'is-active' : ''}`}
                  data-gallery-index={index}
                  data-gallery-image={image}
                  aria-label={`View ${project.title} preview ${index + 1}`}
                  aria-pressed={index === 0}
                >
                  <img src={image} alt={`${project.title} preview ${index + 1}`} />
                </button>
              ))}
            </div>
          </div>
        )}

        {(!project.gallery || project.gallery.length === 0) && (
          <div class={`hero-image ${project.slug === 'cashwave-mobile' ? 'is-mobile' : ''}`}>
            <img src={project.image} alt={`${project.title} Preview`} />
          </div>
        )}
      </div>
    </section>

    <!-- Overview Section -->
    <section class="content-section overview-section">
      <div class="container container-sm">
        <div class="overview-grid">
          <div class="overview-item">
            <h3>Purpose</h3>
            <p>{project.overview?.purpose}</p>
          </div>
          <div class="overview-item">
            <h3>My Role</h3>
            <p>{project.overview?.role}</p>
          </div>
          <div class="overview-item">
            <h3>Status</h3>
            <p>{project.overview?.status}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Problem & Solution -->
    <section class="content-section split-section bg-secondary">
      <div class="container container-sm">
        <div class="content-block mb-16">
          <h2 class="section-heading">The Problem</h2>
          <p class="body-large">{project.problemStatement}</p>
        </div>
        <div class="content-block">
          <h2 class="section-heading">The Solution</h2>
          <p class="body-large">{project.solution}</p>
        </div>
      </div>
    </section>

    <!-- Architecture & Features -->
    <section class="content-section">
      <div class="container container-sm">
        <div class="content-block mb-16">
          <h2 class="section-heading">Tech Stack & Architecture</h2>
          <div class="arch-card">
            <div class="arch-item">
              <span class="arch-label">Frontend</span>
              <span class="arch-value">{project.architecture?.frontend || "N/A"}</span>
            </div>
            <div class="arch-item">
              <span class="arch-label">Backend</span>
              <span class="arch-value">{project.architecture?.backend || "N/A"}</span>
            </div>
            <div class="arch-item">
              <span class="arch-label">Database</span>
              <span class="arch-value">{project.architecture?.database || "N/A"}</span>
            </div>
            <div class="arch-item">
              <span class="arch-label">Deployment</span>
              <span class="arch-value">{project.architecture?.deployment || "N/A"}</span>
            </div>
          </div>
          <p class="arch-reason"><strong>Why these technologies?</strong> {project.architecture?.reasons}</p>
        </div>

        <div class="content-block">
          <h2 class="section-heading">Key Features</h2>
          <ul class="features-list">
            {project.features?.map((feature) => (
              <li>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Challenges & Impact -->
    <section class="content-section bg-secondary">
      <div class="container container-sm">
        <div class="content-block mb-16">
          <h2 class="section-heading">Challenges & Solutions</h2>
          <div class="challenges-list">
            {project.challenges?.map((item) => (
              <div class="challenge-card">
                <div class="challenge-part">
                  <h4>Challenge</h4>
                  <p>{item.challenge}</p>
                </div>
                <div class="solution-part">
                  <h4>Solution</h4>
                  <p>{item.solution}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="content-block">
          <h2 class="section-heading">Impact & Results</h2>
          <div class="impact-card">
            <svg class="impact-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <p class="body-large">{project.impact}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="bottom-nav">
      <div class="container">
        <div class="cta-wrapper">
          <h2 class="cta-title">Interested in working together?</h2>
          <a href="/#contact" class="primary-btn">Get In Touch</a>
        </div>
      </div>
    </section>
  </main>

  <div class="lightbox-backdrop" id="lightbox-backdrop" aria-hidden="true">
    <div class="lightbox-content" role="dialog" aria-modal="true" aria-label="Project image preview">
      <button type="button" class="lightbox-close" id="lightbox-close" aria-label="Close image preview">
        ×
      </button>

      <button type="button" class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="Previous image">
        ‹
      </button>

      <img class="lightbox-image" id="lightbox-image" src="" alt="Project preview" />

      <button type="button" class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="Next image">
        ›
      </button>
    </div>
  </div>

  <script>
    const galleryFeatureImage = document.querySelector('.gallery-feature-button img');
    const galleryThumbs = document.querySelectorAll('.gallery-thumb');
    const galleryPrev = document.querySelector('.gallery-prev');
    const galleryNext = document.querySelector('.gallery-next');
    const lightboxBackdrop = document.getElementById('lightbox-backdrop');
    const lightboxImage = document.getElementById('lightbox-image');
    const lightboxClose = document.getElementById('lightbox-close');
    const lightboxPrev = document.getElementById('lightbox-prev');
    const lightboxNext = document.getElementById('lightbox-next');
    const galleryImages = Array.from(document.querySelectorAll('.gallery-thumb')).map((thumb) => thumb.getAttribute('data-gallery-image'));

    let currentIndex = 0;

    const updateFeaturedImage = (index) => {
      const safeIndex = (index + galleryImages.length) % galleryImages.length;
      currentIndex = safeIndex;

      const selectedImage = galleryImages[safeIndex];

      if (galleryFeatureImage && selectedImage) {
        galleryFeatureImage.src = selectedImage;
        galleryFeatureImage.alt = `Project preview ${safeIndex + 1}`;
      }

      galleryThumbs.forEach((thumb, thumbIndex) => {
        const isActive = thumbIndex === safeIndex;
        thumb.classList.toggle('is-active', isActive);
        thumb.setAttribute('aria-pressed', String(isActive));
      });

      const featureButton = document.querySelector('.gallery-feature-button');
      if (featureButton) {
        featureButton.setAttribute('data-open-gallery', String(safeIndex));
        featureButton.setAttribute('aria-label', `Open project preview ${safeIndex + 1}`);
      }

      if (lightboxImage) {
        lightboxImage.src = selectedImage || '';
      }
    };

    const moveGallery = (direction) => {
      if (!galleryImages.length) return;
      updateFeaturedImage(currentIndex + direction);
    };

    galleryThumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const index = Number(thumb.getAttribute('data-gallery-index'));
        updateFeaturedImage(index);
      });
    });

    galleryPrev?.addEventListener('click', () => moveGallery(-1));
    galleryNext?.addEventListener('click', () => moveGallery(1));

    document.querySelectorAll('.gallery-feature-button').forEach((button) => {
      button.addEventListener('click', () => {
        const index = Number(button.getAttribute('data-open-gallery') ?? 0);
        if (!galleryImages[index]) return;
        currentIndex = index;
        if (lightboxBackdrop && lightboxImage) {
          lightboxImage.src = galleryImages[index];
          lightboxBackdrop.classList.add('is-visible');
          lightboxBackdrop.setAttribute('aria-hidden', 'false');
        }
      });
    });

    const closeLightbox = () => {
      if (!lightboxBackdrop || !lightboxImage) return;
      lightboxBackdrop.classList.remove('is-visible');
      lightboxBackdrop.setAttribute('aria-hidden', 'true');
      lightboxImage.src = '';
    };

    const navigateLightbox = (direction) => {
      if (!galleryImages.length) return;
      const nextIndex = (currentIndex + direction + galleryImages.length) % galleryImages.length;
      currentIndex = nextIndex;
      updateFeaturedImage(nextIndex);
      if (lightboxImage) {
        lightboxImage.src = galleryImages[nextIndex] || '';
      }
    };

    lightboxClose?.addEventListener('click', closeLightbox);
    lightboxPrev?.addEventListener('click', () => navigateLightbox(-1));
    lightboxNext?.addEventListener('click', () => navigateLightbox(1));

    lightboxBackdrop?.addEventListener('click', (event) => {
      if (event.target === lightboxBackdrop) closeLightbox();
    });

    document.addEventListener('keydown', (event) => {
      if (lightboxBackdrop?.classList.contains('is-visible')) {
        if (event.key === 'Escape') closeLightbox();
        if (event.key === 'ArrowLeft') navigateLightbox(-1);
        if (event.key === 'ArrowRight') navigateLightbox(1);
      }
    });
  </script>
</Layout>

<style>
  :root {
    --bg-primary: #0a0a0f;
    --bg-secondary: #0f172a;
    --text-primary: #ffffff;
    --text-secondary: #a1a1aa;
    --border-color: rgba(255, 255, 255, 0.08);
    --accent-blue: #2563eb;
    --accent-cyan: #06b6d4;
    --accent-sky: #38bdf8;
  }

  .project-detail {
    background: var(--bg-primary);
    color: var(--text-primary);
    padding-top: 6rem;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .container-sm {
    max-width: 800px;
  }

  /* Section Utilities */
  .content-section {
    padding: 6rem 0;
  }
  
  .bg-secondary {
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }

  .mb-16 {
    margin-bottom: 4rem;
  }

  .section-heading {
    font-size: 2rem;
    font-weight: 400;
    margin-bottom: 2rem;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .body-large {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--text-secondary);
    font-weight: 300;
  }

  /* Hero Section */
  .hero-section {
    padding: 4rem 0 6rem;
    position: relative;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 3rem;
    transition: color 0.3s ease;
  }

  .back-link:hover {
    color: var(--accent-sky);
  }

  .hero-content {
    margin-bottom: 4rem;
  }

  .project-category {
    display: inline-block;
    color: var(--accent-sky);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .project-title {
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 400;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }

  .project-tagline {
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    color: var(--text-secondary);
    max-width: 800px;
    line-height: 1.6;
    font-weight: 300;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    align-items: center;
    justify-content: space-between;
    margin-top: 3rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border-color);
  }

  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .tech-badge {
    padding: 0.5rem 1rem;
    background: rgba(37, 99, 235, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 100px;
    font-size: 0.875rem;
    color: var(--accent-sky);
    font-weight: 400;
    letter-spacing: 0.05em;
  }

  .project-links {
    display: flex;
    gap: 1rem;
  }

  .primary-btn, .secondary-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 9999px;
    transition: all 0.3s ease;
  }

  .primary-btn {
    background: linear-gradient(135deg, var(--accent-blue), var(--accent-cyan));
    color: #ffffff;
    box-shadow: 0 4px 15px rgba(37, 99, 235, 0.3);
  }

  .primary-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(6, 182, 212, 0.4);
  }

  .secondary-btn {
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
  }

  .secondary-btn:hover {
    background: rgba(37, 99, 235, 0.15);
    border-color: var(--accent-sky);
    color: var(--accent-sky);
    transform: translateY(-2px);
  }

  .hero-image {
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    aspect-ratio: 16/9;
    border: 1px solid rgba(56, 189, 248, 0.2);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-showcase {
    margin-top: 2rem;
    display: grid;
    gap: 1rem;
  }

  .gallery-showcase.is-mobile {
    width: min(100%, 760px);
    margin: 2rem auto 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    justify-items: center;
    gap: 1.1rem;
    padding: 1rem 1rem 1rem 1.25rem;
    border: 1px solid rgba(148, 163, 184, 0.14);
    border-radius: 30px;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.6), rgba(15, 23, 42, 0.24));
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
  }

  .gallery-device-shell {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    width: 100%;
    min-width: 0;
  }

  .gallery-feature {
    position: relative;
    width: min(28vw, 240px);
    aspect-ratio: 9 / 16;
    border-radius: 28px;
    overflow: hidden;
    border: 8px solid rgba(9, 15, 26, 0.96);
    box-shadow:
      inset 0 0 0 2px rgba(148, 163, 184, 0.25),
      0 22px 40px rgba(15, 23, 42, 0.7),
      0 0 0 1px rgba(56, 189, 248, 0.15);
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.92), rgba(2, 6, 23, 0.94));
    padding: 0.45rem;
  }

  .gallery-feature-button {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .gallery-feature-button img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.95), rgba(2, 6, 23, 0.95));
    transition: transform 0.35s ease, filter 0.35s ease;
  }

  .gallery-feature-button:hover img {
    transform: scale(1.02);
    filter: brightness(1.06) saturate(1.12);
  }

  .gallery-nav {
    width: 2.2rem;
    height: 2.2rem;
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 50%;
    background: rgba(15, 23, 42, 0.72);
    color: #fff;
    font-size: 1.7rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 10px 22px rgba(15, 23, 42, 0.25);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .gallery-thumbs {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.6rem;
    width: 92px;
    max-height: 460px;
    overflow-y: auto;
    padding: 0.2rem 0.1rem;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .gallery-thumbs::-webkit-scrollbar {
    display: none;
  }

  .gallery-thumb {
    position: relative;
    flex: 0 0 82px;
    width: 100%;
    aspect-ratio: 9 / 16;
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 16px;
    overflow: hidden;
    padding: 0;
    cursor: pointer;
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
    box-shadow: 0 10px 20px rgba(15, 23, 42, 0.22);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .gallery-thumb:hover,
  .gallery-thumb.is-active {
    transform: translateX(-2px);
    border-color: rgba(56, 189, 248, 0.8);
    box-shadow: 0 12px 18px rgba(6, 182, 212, 0.18);
  }

  .gallery-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.95), rgba(2, 6, 23, 0.95));
  }

  .gallery-showcase:not(.is-mobile) {
    width: 100%;
    gap: 1rem;
  }

  .gallery-showcase:not(.is-mobile) .gallery-device-shell {
    gap: 0.8rem;
  }

  .gallery-showcase:not(.is-mobile) .gallery-feature {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 20px;
    border-width: 1px;
    padding: 0.35rem;
  }

  .gallery-showcase:not(.is-mobile) .gallery-feature-button img {
    border-radius: 14px;
  }

  .gallery-showcase:not(.is-mobile) .gallery-thumbs {
    flex-direction: row;
    justify-content: flex-start;
    width: 100%;
    max-height: none;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.2rem 0.1rem 0.35rem;
  }

  .gallery-showcase:not(.is-mobile) .gallery-thumb {
    flex: 0 0 150px;
    width: 150px;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
  }

  .gallery-showcase:not(.is-mobile) .gallery-thumb:hover,
  .gallery-showcase:not(.is-mobile) .gallery-thumb.is-active {
    transform: translateY(-2px);
  }

  .lightbox-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(2, 6, 23, 0.82);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, visibility 0.2s ease;
    z-index: 1000;
  }

  .lightbox-backdrop.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .lightbox-content {
    position: relative;
    max-width: min(1200px, 90vw);
    max-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(15, 23, 42, 0.9);
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: 20px;
    padding: 1rem;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.5);
  }

